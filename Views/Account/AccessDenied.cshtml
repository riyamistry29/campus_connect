@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto bg-white" style="max-width: 550px;">
        <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" 
             style="width: 80px; height: 80px; font-size: 2.5rem;">
            <i class="bi bi-shield-x"></i>
        </div>
        <h2 class="fw-bold mb-2">Access Denied</h2>
        <p class="text-muted mb-4">
            You do not have the required role permissions to view or perform operations on this page. If you believe this is in error, please contact your college administrator.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-house me-1"></i> Home
            </a>
            @if (User.IsInRole("Student"))
            {
                <a asp-controller="Registrations" asp-action="Dashboard" class="btn btn-primary-custom rounded-pill px-4">
                    Student Dashboard
                </a>
            }
            else if (User.IsInRole("Organizer"))
            {
                <a asp-controller="Organizer" asp-action="Dashboard" class="btn btn-primary-custom rounded-pill px-4">
                    Organizer Dashboard
                </a>
            }
            else if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary-custom rounded-pill px-4">
                    Admin Dashboard
                </a>
            }
        </div>
    </div>
</div>
