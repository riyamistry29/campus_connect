@model IEnumerable<CampusConnect.Models.CollegeEvent>
@{
    ViewData["Title"] = "My Events";
}

<div class="dashboard-container">
    <!-- Sidebar Navigation -->
    <aside class="dashboard-sidebar">
        <div class="d-flex align-items-center gap-2 mb-4 px-2">
            <div class="bg-success text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                <i class="bi bi-kanban"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0">Organizer Portal</h6>
                <span class="small text-muted" style="font-size: 0.75rem;">Event Management</span>
            </div>
        </div>

        <div class="sidebar-heading">Navigation</div>
        <a asp-action="Dashboard" class="sidebar-nav-item">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-action="MyEvents" class="sidebar-nav-item active">
            <i class="bi bi-calendar-event"></i> My Events
        </a>
        <a asp-action="Create" class="sidebar-nav-item">
            <i class="bi bi-plus-circle"></i> Create New Event
        </a>

        <div class="sidebar-heading">Account & Views</div>
        <a asp-controller="Events" asp-action="Index" class="sidebar-nav-item">
            <i class="bi bi-eye"></i> Public Events Page
        </a>
        <a asp-controller="Account" asp-action="Profile" class="sidebar-nav-item">
            <i class="bi bi-person-gear"></i> Organizer Profile
        </a>
    </aside>

    <!-- Main Content Area -->
    <main class="dashboard-content">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">My Hosted Events</h2>
                <p class="text-muted small mb-0">Manage and monitor events organized under your account.</p>
            </div>
            <a asp-action="Create" class="btn btn-primary-custom">
                <i class="bi bi-plus-lg me-1"></i> Create New Event
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <i class="bi bi-calendar-plus fs-1 text-muted mb-3"></i>
                <h5 class="fw-bold">No Events Created Yet</h5>
                <p class="text-muted small mb-4">Start by publishing your first college event, hackathon, or seminar.</p>
                <div>
                    <a asp-action="Create" class="btn btn-primary-custom rounded-pill px-4">
                        Create Your First Event
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Event Title</th>
                                <th>Category</th>
                                <th>Event Date</th>
                                <th>Capacity</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@ev.Title</div>
                                        <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@ev.Venue</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@ev.Category.Name</span>
                                    </td>
                                    <td class="small">
                                        @ev.StartDateTime.ToString("MMM dd, yyyy")<br>
                                        <span class="text-muted">@ev.StartDateTime.ToString("hh:mm tt")</span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold mb-1">@ev.ConfirmedRegistrationsCount / @ev.Capacity</div>
                                        <div class="progress" style="height: 5px; width: 100px;">
                                            @{
                                                var pct = ev.Capacity > 0 ? (int)((double)ev.ConfirmedRegistrationsCount / ev.Capacity * 100) : 0;
                                            }
                                            <div class="progress-bar @(pct >= 90 ? "bg-danger" : pct >= 70 ? "bg-warning" : "bg-primary")" 
                                                 role="progressbar" style="width: @pct%;"></div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (ev.Status == CampusConnect.Models.EventStatus.Published)
                                        {
                                            <span class="badge bg-success-subtle text-success">Published</span>
                                        }
                                        else if (ev.Status == CampusConnect.Models.EventStatus.PendingApproval)
                                        {
                                            <span class="badge bg-warning-subtle text-warning">Pending Approval</span>
                                        }
                                        else if (ev.Status == CampusConnect.Models.EventStatus.Draft)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Draft</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">@ev.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="ManageRegistrations" asp-route-id="@ev.Id" class="btn btn-outline-primary" title="Registrations & Attendance">
                                                <i class="bi bi-people"></i>
                                            </a>
                                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="btn btn-outline-secondary" title="View Public Page">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-outline-secondary" title="Edit Event">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@ev.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event? This will also remove attendee registrations.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete Event">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </main>
</div>
