@model CampusConnect.ViewModels.ManageRegistrationsViewModel
@{
    ViewData["Title"] = "Manage Registrations: " + Model.Event.Title;
    var ev = Model.Event;
}

<div class="dashboard-container">
    <!-- Sidebar Navigation -->
    <aside class="dashboard-sidebar">
        <div class="d-flex align-items-center gap-2 mb-4 px-2">
            <div class="bg-success text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                <i class="bi bi-kanban"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0">Organizer Portal</h6>
                <span class="small text-muted" style="font-size: 0.75rem;">Event Management</span>
            </div>
        </div>

        <div class="sidebar-heading">Navigation</div>
        <a asp-action="Dashboard" class="sidebar-nav-item">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-action="MyEvents" class="sidebar-nav-item active">
            <i class="bi bi-calendar-event"></i> My Events
        </a>
        <a asp-action="Create" class="sidebar-nav-item">
            <i class="bi bi-plus-circle"></i> Create New Event
        </a>
    </aside>

    <!-- Main Content Area -->
    <main class="dashboard-content">
        <!-- Breadcrumb & Actions -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Attendee & Attendance Management</h2>
                <p class="text-muted small mb-0">
                    Event: <strong class="text-dark">@ev.Title</strong> | Venue: @ev.Venue
                </p>
            </div>
            <a asp-action="MyEvents" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Events
            </a>
        </div>

        <!-- Event Summary Strip -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                    <div class="fs-4 fw-bold text-primary">@ev.Capacity</div>
                    <span class="small text-muted">Total Seat Capacity</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                    <div class="fs-4 fw-bold text-success">@Model.Registrations.Count(r => r.Status == CampusConnect.Models.RegistrationStatus.Confirmed)</div>
                    <span class="small text-muted">Confirmed Attendees</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                    <div class="fs-4 fw-bold text-info">@Model.Registrations.Count(r => r.AttendanceStatus == CampusConnect.Models.AttendanceStatus.Present)</div>
                    <span class="small text-muted">Present Marked</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                    <div class="fs-4 fw-bold text-warning">@ev.AvailableSeats</div>
                    <span class="small text-muted">Seats Available</span>
                </div>
            </div>
        </div>

        <!-- Filter & Search Card -->
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
            <form method="get" asp-action="ManageRegistrations" asp-route-id="@ev.Id">
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" name="search" value="@Model.Search" class="form-control bg-light border-start-0" 
                                   placeholder="Search by student name, email, or roll no..." />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="attendance" class="form-select bg-light">
                            <option value="">All Attendance Statuses</option>
                            <option value="NotMarked" selected="@(Model.AttendanceFilter == CampusConnect.Models.AttendanceStatus.NotMarked ? "selected" : null)">Not Marked</option>
                            <option value="Present" selected="@(Model.AttendanceFilter == CampusConnect.Models.AttendanceStatus.Present ? "selected" : null)">Present</option>
                            <option value="Absent" selected="@(Model.AttendanceFilter == CampusConnect.Models.AttendanceStatus.Absent ? "selected" : null)">Absent</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="status" class="form-select bg-light">
                            <option value="">All Registrations</option>
                            <option value="Confirmed" selected="@(Model.StatusFilter == CampusConnect.Models.RegistrationStatus.Confirmed ? "selected" : null)">Confirmed</option>
                            <option value="Cancelled" selected="@(Model.StatusFilter == CampusConnect.Models.RegistrationStatus.Cancelled ? "selected" : null)">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary-custom flex-grow-1">Filter</button>
                        <a asp-action="ManageRegistrations" asp-route-id="@ev.Id" class="btn btn-outline-secondary" title="Clear">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <!-- Registrations Table -->
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Registered Student Roster (@Model.Registrations.Count)</h5>
            </div>

            @if (!Model.Registrations.Any())
            {
                <div class="p-5 text-center text-muted small">
                    <i class="bi bi-person-x fs-1 mb-2 d-block"></i>
                    No registrations found matching the specified search or filter criteria.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student Details</th>
                                <th>Department & Roll No</th>
                                <th>Enrolled At</th>
                                <th>Registration Status</th>
                                <th>Attendance Status</th>
                                <th class="text-end">Mark Attendance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in Model.Registrations)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@reg.Student.FullName</div>
                                        <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@reg.Student.Email</div>
                                    </td>
                                    <td>
                                        <div>@reg.Student.Department</div>
                                        <small class="text-muted">@(reg.Student.StudentIdentifier ?? "N/A")</small>
                                    </td>
                                    <td class="small text-muted">
                                        @reg.RegisteredAt.ToString("MMM dd, yyyy")<br>
                                        @reg.RegisteredAt.ToString("hh:mm tt")
                                    </td>
                                    <td>
                                        @if (reg.Status == CampusConnect.Models.RegistrationStatus.Confirmed)
                                        {
                                            <span class="badge bg-success-subtle text-success">Confirmed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">@reg.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (reg.AttendanceStatus == CampusConnect.Models.AttendanceStatus.Present)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Present</span>
                                        }
                                        else if (reg.AttendanceStatus == CampusConnect.Models.AttendanceStatus.Absent)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Absent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Not Marked</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (reg.Status == CampusConnect.Models.RegistrationStatus.Confirmed)
                                        {
                                            <div class="btn-group btn-group-sm">
                                                <!-- Mark Present -->
                                                <form asp-action="MarkAttendance" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="registrationId" value="@reg.Id" />
                                                    <input type="hidden" name="eventId" value="@ev.Id" />
                                                    <input type="hidden" name="status" value="@CampusConnect.Models.AttendanceStatus.Present" />
                                                    <button type="submit" class="btn @(reg.AttendanceStatus == CampusConnect.Models.AttendanceStatus.Present ? "btn-success disabled" : "btn-outline-success")" 
                                                            title="Mark Present">
                                                        <i class="bi bi-check-lg"></i> Present
                                                    </button>
                                                </form>

                                                <!-- Mark Absent -->
                                                <form asp-action="MarkAttendance" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="registrationId" value="@reg.Id" />
                                                    <input type="hidden" name="eventId" value="@ev.Id" />
                                                    <input type="hidden" name="status" value="@CampusConnect.Models.AttendanceStatus.Absent" />
                                                    <button type="submit" class="btn @(reg.AttendanceStatus == CampusConnect.Models.AttendanceStatus.Absent ? "btn-danger disabled" : "btn-outline-danger")" 
                                                            title="Mark Absent">
                                                        <i class="bi bi-x-lg"></i> Absent
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Cancelled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>
</div>
