@model IEnumerable<CampusConnect.Models.EventRegistration>
@{
    ViewData["Title"] = "Platform Registrations Log";
    var statusFilter = ViewBag.StatusFilter as CampusConnect.Models.RegistrationStatus?;
    var search = ViewBag.Search as string;
}

<div class="dashboard-container">
    <!-- Admin Sidebar -->
    <aside class="dashboard-sidebar">
        <div class="d-flex align-items-center gap-2 mb-4 px-2">
            <div class="bg-danger text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0">Admin Center</h6>
                <span class="small text-muted" style="font-size: 0.75rem;">Platform Administration</span>
            </div>
        </div>

        <div class="sidebar-heading">Core Administration</div>
        <a asp-action="Dashboard" class="sidebar-nav-item">
            <i class="bi bi-speedometer2"></i> System Overview
        </a>
        <a asp-action="ModerateEvents" class="sidebar-nav-item">
            <i class="bi bi-check2-circle"></i> Moderate Events
        </a>
        <a asp-action="Categories" class="sidebar-nav-item">
            <i class="bi bi-tags"></i> Event Categories
        </a>
        <a asp-action="Users" class="sidebar-nav-item">
            <i class="bi bi-people"></i> User Management
        </a>
        <a asp-action="AllRegistrations" class="sidebar-nav-item active">
            <i class="bi bi-receipt"></i> All Registrations
        </a>
    </aside>

    <!-- Main Content -->
    <main class="dashboard-content">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Campus Registrations Audit Log</h2>
                <p class="text-muted small mb-0">Comprehensive record of all student event registrations and verified attendance across campus.</p>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
            <form method="get" asp-action="AllRegistrations">
                <div class="row g-2 align-items-center">
                    <div class="col-md-7">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" name="search" value="@search" class="form-control bg-light border-start-0" 
                                   placeholder="Search student name, email, or event title..." />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="statusFilter" class="form-select bg-light">
                            <option value="">All Statuses</option>
                            <option value="Confirmed" selected="@(statusFilter == CampusConnect.Models.RegistrationStatus.Confirmed ? "selected" : null)">Confirmed</option>
                            <option value="Cancelled" selected="@(statusFilter == CampusConnect.Models.RegistrationStatus.Cancelled ? "selected" : null)">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary-custom flex-grow-1">Filter</button>
                        <a asp-action="AllRegistrations" class="btn btn-outline-secondary" title="Reset">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <!-- Table -->
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted small">
                    <i class="bi bi-ticket-detailed fs-1 text-muted mb-2 d-block"></i>
                    No registrations found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Event Enrolled</th>
                                <th>Date & Time</th>
                                <th>Registration Status</th>
                                <th>Attendance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@reg.Student.FullName</div>
                                        <small class="text-muted">@reg.Student.Email</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 250px;">
                                            @reg.Event.Title
                                        </div>
                                        <span class="badge bg-light text-dark border small">@reg.Event.Category.Name</span>
                                    </td>
                                    <td class="small text-muted">
                                        @reg.RegisteredAt.ToString("MMM dd, yyyy • hh:mm tt")
                                    </td>
                                    <td>
                                        @if (reg.Status == CampusConnect.Models.RegistrationStatus.Confirmed)
                                        {
                                            <span class="badge bg-success-subtle text-success">Confirmed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">@reg.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (reg.AttendanceStatus == CampusConnect.Models.AttendanceStatus.Present)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Present</span>
                                        }
                                        else if (reg.AttendanceStatus == CampusConnect.Models.AttendanceStatus.Absent)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Absent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Not Marked</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>
</div>
