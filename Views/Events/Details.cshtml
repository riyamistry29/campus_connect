@model CampusConnect.ViewModels.EventDetailsViewModel
@{
    ViewData["Title"] = Model.Event.Title;
    var ev = Model.Event;
}

<div class="container py-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Events" asp-action="Index">Events</a></li>
            <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">@ev.Title</li>
        </ol>
    </nav>

    <!-- Large Event Banner & Header -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
        <div class="position-relative" style="height: 380px; background-color: #0f172a;">
            <img src="@(string.IsNullOrWhiteSpace(ev.BannerUrl) ? "https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=1400&q=80" : ev.BannerUrl)" 
                 alt="@ev.Title" class="w-100 h-100" style="object-fit: cover; opacity: 0.85;" />
            <div class="position-absolute bottom-0 start-0 w-100 p-4 p-md-5" 
                 style="background: linear-gradient(to top, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.4) 70%, transparent 100%);">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge bg-primary px-3 py-1 rounded-pill text-uppercase">
                        @ev.Category.Name
                    </span>
                    @if (ev.Status == CampusConnect.Models.EventStatus.Published)
                    {
                        <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">
                            Published
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill">
                            @ev.Status
                        </span>
                    }
                </div>
                <h1 class="text-white fw-bold display-6 mb-2">@ev.Title</h1>
                <div class="d-flex flex-wrap gap-4 text-white-50 small">
                    <div><i class="bi bi-geo-alt me-1 text-danger"></i>@ev.Venue</div>
                    <div><i class="bi bi-calendar3 me-1 text-info"></i>@ev.StartDateTime.ToString("dddd, MMMM dd, yyyy")</div>
                    <div><i class="bi bi-clock me-1 text-warning"></i>@ev.StartDateTime.ToString("hh:mm tt") - @ev.EndDateTime.ToString("hh:mm tt")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Description & Announcements Left Column -->
        <div class="col-lg-8">
            <!-- About Event -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i>About This Event</h4>
                <div class="text-secondary fs-6" style="white-space: pre-line; line-height: 1.7;">
                    @ev.Description
                </div>

                @if (!string.IsNullOrEmpty(ev.Eligibility))
                {
                    <div class="mt-4 p-3 bg-light rounded-3 border-start border-primary border-4">
                        <h6 class="fw-bold mb-1 text-dark"><i class="bi bi-shield-check text-primary me-1"></i>Eligibility & Prerequisites</h6>
                        <p class="small text-muted mb-0">@ev.Eligibility</p>
                    </div>
                }
            </div>

            <!-- Announcements Section -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0">
                        <i class="bi bi-megaphone text-primary me-2"></i>Organizer Announcements
                        <span class="badge bg-light text-dark border ms-2 font-monospace">@Model.Announcements.Count</span>
                    </h4>
                    @if (Model.IsOrganizerOrAdmin)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#announcementModal">
                            <i class="bi bi-plus-circle me-1"></i> Post Update
                        </button>
                    }
                </div>

                @if (!Model.Announcements.Any())
                {
                    <div class="p-4 bg-light rounded-3 text-center text-muted small">
                        No announcements posted yet. Check back closer to event date for updates.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var announcement in Model.Announcements)
                        {
                            <div class="p-3 rounded-3 border bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="fw-bold text-dark mb-0">@announcement.Title</h6>
                                    <span class="small text-muted">@announcement.CreatedAt.ToString("MMM dd, yyyy • hh:mm tt")</span>
                                </div>
                                <p class="text-secondary small mb-1" style="white-space: pre-line;">@announcement.Message</p>
                                <div class="small text-muted">
                                    <i class="bi bi-person-circle me-1"></i>Posted by @announcement.CreatedBy.FullName
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Registration Card & Meta Right Column -->
        <div class="col-lg-4">
            <!-- Registration Action Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold mb-3">Event Registration</h5>

                <!-- Capacity Stats -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Capacity Filled</span>
                        <strong class="text-dark">@ev.ConfirmedRegistrationsCount / @ev.Capacity</strong>
                    </div>
                    <div class="progress" style="height: 8px;">
                        @{
                            var pct = ev.Capacity > 0 ? (int)((double)ev.ConfirmedRegistrationsCount / ev.Capacity * 100) : 0;
                        }
                        <div class="progress-bar @(pct >= 90 ? "bg-danger" : pct >= 70 ? "bg-warning" : "bg-primary")" 
                             role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="small text-muted mt-2 d-flex justify-content-between">
                        <span>Available Seats:</span>
                        <span class="fw-bold text-success">@ev.AvailableSeats Seats</span>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 small">
                    <div class="mb-1"><i class="bi bi-clock-history text-danger me-2"></i><strong>Deadline:</strong> @ev.RegistrationDeadline.ToString("MMM dd, yyyy • hh:mm tt")</div>
                    <div><i class="bi bi-cash-stack text-success me-2"></i><strong>Fee:</strong> Free for college students</div>
                </div>

                <!-- Registration Decision State -->
                @if (Model.IsUserRegistered)
                {
                    <div class="alert alert-success border-0 rounded-3 p-3 mb-3 text-center">
                        <i class="bi bi-check-circle-fill fs-3 text-success d-block mb-1"></i>
                        <strong class="d-block">You Are Registered!</strong>
                        <span class="small text-muted">
                            Status: <span class="badge bg-success">@Model.UserRegistration?.Status</span>
                        </span>
                        @if (Model.UserRegistration?.AttendanceStatus != CampusConnect.Models.AttendanceStatus.NotMarked)
                        {
                            <div class="mt-2 small">
                                Attendance: <span class="badge @(Model.UserRegistration?.AttendanceStatus == CampusConnect.Models.AttendanceStatus.Present ? "bg-success" : "bg-danger")">
                                    @Model.UserRegistration?.AttendanceStatus
                                </span>
                            </div>
                        }
                    </div>

                    @if (DateTime.UtcNow < ev.StartDateTime)
                    {
                        <form asp-action="Cancel" asp-route-id="@ev.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel your registration? This will free your seat for other students.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100 rounded-pill py-2">
                                <i class="bi bi-x-circle me-1"></i> Cancel Registration
                            </button>
                        </form>
                    }
                }
                else if (Model.CanRegister)
                {
                    <form asp-action="Register" asp-route-id="@ev.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary-custom w-100 py-3 rounded-pill fs-6">
                            <i class="bi bi-ticket-perforated me-1"></i> Confirm Registration
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning border-0 rounded-3 p-3 text-center small mb-3">
                        <i class="bi bi-exclamation-circle fs-4 text-warning d-block mb-1"></i>
                        @Model.RegistrationRestrictionReason
                    </div>

                    @if (!User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary-custom w-100 py-2 rounded-pill">
                            Sign In to Register
                        </a>
                    }
                }

                @if (Model.IsOrganizerOrAdmin)
                {
                    <div class="pt-3 border-top mt-3 text-center">
                        <span class="badge bg-secondary-subtle text-secondary mb-2">Organizer Controls</span>
                        <div class="d-grid gap-2">
                            <a asp-controller="Organizer" asp-action="ManageRegistrations" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-people me-1"></i> Manage Registrations & Attendance
                            </a>
                            <a asp-controller="Organizer" asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil me-1"></i> Edit Event Details
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- Organizer Profile Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold text-muted small text-uppercase mb-3">Event Organizer</h6>
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" 
                         style="width: 48px; height: 48px;">
                        @(string.IsNullOrEmpty(ev.Organizer.FullName) ? "O" : ev.Organizer.FullName[0].ToString().ToUpper())
                    </div>
                    <div>
                        <div class="fw-bold text-dark">@ev.Organizer.FullName</div>
                        <div class="small text-muted">@ev.Organizer.Department</div>
                        <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@ev.Organizer.Email</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Post Announcement -->
@if (Model.IsOrganizerOrAdmin)
{
    <div class="modal fade" id="announcementModal" tabindex="-1" aria-labelledby="announcementModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold" id="announcementModalLabel">Post Event Announcement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="AddAnnouncement" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@ev.Id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Title / Subject</label>
                            <input type="text" name="title" class="form-control" placeholder="e.g. Schedule Update or Discord Link" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Announcement Message</label>
                            <textarea name="message" class="form-control" rows="4" placeholder="Write message to attendees..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary-custom rounded-pill px-4">Publish Announcement</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
