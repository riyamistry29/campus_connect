@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusConnect</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Our CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-custom">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-mortarboard-fill"></i> CampusConnect
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <i class="bi bi-list fs-2"></i>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto ms-3">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house me-1"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Events" asp-action="Index">
                        <i class="bi bi-calendar-event me-1"></i> Events
                    </a>
                </li>

                @if (SignInManager.IsSignedIn(User))
                {
                    @if (User.IsInRole("Student"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Registrations" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> My Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Registrations" asp-action="Index">
                                <i class="bi bi-ticket me-1"></i> My Registrations
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Organizer") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Organizer" asp-action="Dashboard">
                                <i class="bi bi-kanban me-1"></i> Organizer Panel
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-shield-lock me-1"></i> Admin Panel
                            </a>
                        </li>
                    }
                }
            </ul>

            <!-- Auth -->
            <div class="d-flex align-items-center gap-2">
                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2"
                                type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li class="px-3 py-2 border-bottom">
                                <div class="small fw-bold">@currentUser?.FullName</div>
                                <div class="small text-muted">@currentUser?.Email</div>
                                <span class="badge bg-primary mt-1">
                                    @(User.IsInRole("Admin") ? "Administrator" : User.IsInRole("Organizer") ? "Organizer" : "Student")
                                </span>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-gear me-2"></i> Profile
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Log Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Log In</a>
                    <a class="btn btn-primary-custom btn-sm" asp-controller="Account" asp-action="Register">Sign Up</a>
                }
            </div>
        </div>
    </div>
</nav>

<!-- Toast Alerts -->
<div class="toast-floating">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
</div>

<!-- Page Content -->
<main role="main" class="flex-grow-1">
    @RenderBody()
</main>

<!-- Footer -->
<footer class="py-4">
    <div class="container">
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-mortarboard-fill text-primary fs-4"></i>
                    <span class="fw-bold text-white">CampusConnect</span>
                </div>
                <p class="small text-muted mb-0">
                    College Event Management System — Built with ASP.NET Core 10 MVC &amp; PostgreSQL.
                </p>
            </div>
            <div class="col-md-4">
                <h6 class="text-white fw-bold mb-2">Quick Links</h6>
                <ul class="list-unstyled small mb-0">
                    <li class="mb-1"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="mb-1"><a asp-controller="Events" asp-action="Index">Events</a></li>
                    <li class="mb-1"><a asp-controller="Account" asp-action="Login">Login</a></li>
                    <li class="mb-1"><a asp-controller="Account" asp-action="Register">Register</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h6 class="text-white fw-bold mb-2">Tech Stack</h6>
                <div class="small text-muted">
                    <div><i class="bi bi-dot text-info"></i> ASP.NET Core 10 MVC (C#)</div>
                    <div><i class="bi bi-dot text-info"></i> PostgreSQL + EF Core</div>
                    <div><i class="bi bi-dot text-info"></i> ASP.NET Core Identity</div>
                    <div><i class="bi bi-dot text-info"></i> Bootstrap 5 + Chart.js</div>
                </div>
            </div>
        </div>
        <hr class="border-secondary opacity-25" />
        <div class="text-center small text-muted">
            &copy; 2026 CampusConnect — Academic Project
        </div>
    </div>
</footer>

<!-- Scripts -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
